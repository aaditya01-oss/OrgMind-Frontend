# Copy this file to ".env" and set your own values. Restart "npm start" after changing it.

# Chat widget: which company the chat belongs to when the address has no ?org=...
REACT_APP_PUBLIC_ORG_ID=01

# Cloudflare Turnstile "I'm human" check. Leave empty to turn it off.
# For local testing use Cloudflare's test key: 1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=